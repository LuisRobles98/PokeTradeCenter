<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.poketradecenter.Mapper.interfaces.IUsuarioMapper">

    <!-- SQL para insertar un usuario cuando se registra-->
    <insert id="guardar" parameterType="com.poketradecenter.Clase.Usuario">
        INSERT INTO usuario
        (nombre, email, password, icono)
        VALUES (#{nombre}, #{email}, #{password}, #{icono})
    </insert>
    
    <!-- SQL para actualizar los datos del usuario -->
	<update id="actualizar" parameterType="com.poketradecenter.Clase.Usuario">
	   UPDATE usuario
	   <set>
	       <if test="nombre != null and nombre != ''">
	           nombre = #{nombre},
	       </if>
	       <if test="email != null and email != ''">
	           email = #{email},
	       </if>
	       <if test="password != null and password != ''">
	           password = #{password},
	       </if>
	       <if test="icono != null and icono != ''">
	           icono = #{icono},
	       </if>
	       <if test="idJuego != null and idJuego != ''">
	           id_juego = #{idJuego}
	       </if>
	   </set>
	   WHERE id = #{id}
	</update>
    
    <!-- SQL para recuperar usuarios por criterios-->
    <select id="recuperarPorCriterios" parameterType="com.poketradecenter.Clase.CriteriosUsuario"  resultType="com.poketradecenter.Clase.Usuario">
    	SELECT id, nombre, email, password, icono, id_juego AS idJuego
    	FROM Usuario
    	<where>
	        <if test="id != null">
	            AND id = #{id}
	        </if>
	        <if test="nombre != null and nombre != ''">
	            AND nombre = #{nombre}
	        </if>
	        <if test="email != null and email != ''">
	            AND email = #{email}
	        </if>
	        <if test="password != null and password != ''">
	            AND password = #{password}
	        </if>
	        <if test="icono != null">
	            AND icono = #{icono}
	        </if>
	        <if test="idJuego != null">
	            AND id_juego = #{idJuego}
	        </if>
    	</where>
    </select>

</mapper>